    "predecessor": {},
    "record_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_id": {
      "const": "fal002.gate-record.v1"
    },
    "schema_version": {
      "const": 1
    },
    "sequence": {},
    "series_id": {
      "format": "uuid",
      "type": "string"
    },
    "state": {}
