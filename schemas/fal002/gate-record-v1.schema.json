            "source_record_ids": {},
            "staging_path": {}
          },
          "type": "object"
        },
        "closure": {
          "additionalProperties": false,
          "properties": {
            "decision_hash": {},
            "decision_id": {},
            "eligible_gate_hash": {},
            "eligible_gate_id": {}
          },
          "type": "object"
        },
        "control": {
          "additionalProperties": false,
          "properties": {
            "correction_count": {},
            "decision_applications": {},
            "decision_bindings": {},
            "decision_requirements": {},
            "diff_hash": {},
            "evidence_hash": {},
            "finding_checkpoint": {},
            "finding_events": {},
            "finding_ids": {},
            "ordinal": {},
            "progress": {}
          },
          "type": "object"
        },
        "correction_count": {},
        "eligibility": {
          "additionalProperties": false,
          "properties": {
            "criterion_ids": {},
            "eligible": {},
            "finding_ids": {},
            "review_hash": {},
            "review_id": {}
          },
          "type": "object"
        },
        "evidence": {
