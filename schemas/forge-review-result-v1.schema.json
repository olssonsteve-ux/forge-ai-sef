{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "result", "findings", "criterion_coverage", "reviewer_identity", "execution_identity", "packet_hash", "reviewer_execution", "review_result_hash"],
  "properties": {
    "schema_version": {"const": "forge-review-result/1.0"}, "result": {"enum": ["PASS", "CORRECTION_REQUIRED", "BLOCKED", "INCONCLUSIVE"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}, "criterion_coverage": {"type": "array", "items": {"type": "string"}},
    "criterion_evidence": {"type": "object"}, "reviewer_identity": {"type": "string"}, "execution_identity": {"type": "string"}, "packet_hash": {"type": "string"},
    "reviewer_execution": {"type": "object"}, "review_result_hash": {"type": "string"}
  },
  "$defs": {"finding": {"type": "object", "required": ["id", "criterion_id", "severity", "observation", "evidence_reference", "claim_status", "minimum_remediation", "human_decision_required"], "properties": {"id": {"type": "string"}, "criterion_id": {"type": "string"}, "severity": {"type": "string"}, "observation": {"type": "string"}, "evidence_reference": {"type": "string"}, "claim_status": {"type": "string"}, "minimum_remediation": {"type": "string"}, "human_decision_required": {"type": "boolean"}}, "additionalProperties": false}},
  "additionalProperties": false
}
